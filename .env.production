# Production Environment Variables
# Copy this file to .env and update values for production deployment

# Flask Configuration
FLASK_ENV=production

# Security - Generate a strong random secret for production
JWT_SECRET=your-secure-random-secret-key-here-change-in-production

# Database
DATABASE_URL=sqlite:///./data/app.db

# Server
PORT=5000

# CORS - Update for production domain
CORS_ORIGINS=https://yourdomain.com

# Gunicorn Workers (typically 2-4 x CPU cores)
GUNICORN_WORKERS=4
