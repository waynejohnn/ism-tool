# Cloud Run Deployment Configuration - Dev Environment

GCP_PROJECT_ID=<your-gcp-project-id>
GCP_REGION=us-central1
GCP_ARTIFACT_REPOSITORY=usecase-scoring

BACKEND_SERVICE_NAME=usecaseapp-backend-dev
FRONTEND_SERVICE_NAME=usecaseapp-frontend-dev

# Optional explicit API URL for frontend build. If empty, deploy script uses backend URL.
VITE_API_URL=

# Optional service accounts
BACKEND_SERVICE_ACCOUNT=
FRONTEND_SERVICE_ACCOUNT=

# Optional runtime vars passed directly to Cloud Run
BACKEND_ENV_VARS=FLASK_ENV=production,JWT_SECRET=<generate-secure-random-secret>
FRONTEND_ENV_VARS=
