# ACA Deployment Configuration - Dev Environment
# Use Case Scoring Application
# This file contains all environment variables and configuration for deploying to Azure Container Apps

# ============================================
# DEPLOYMENT ENVIRONMENT
# ============================================
ENVIRONMENT=dev
DEPLOYMENT_TARGET=Azure Container Apps (ACA)
DEPLOYMENT_TIMESTAMP=$(date +%Y%m%d_%H%M%S)

# ============================================
# AZURE RESOURCES
# ============================================
AZURE_SUBSCRIPTION_ID=<your-subscription-id>
AZURE_TENANT_ID=<your-tenant-id>
RESOURCE_GROUP=santee-cooper-apps-dev
AZURE_LOCATION=eastus

# ============================================
# CONTAINER REGISTRY
# ============================================
REGISTRY_NAME=usecaseregistry
REGISTRY_URL=usecaseregistry.azurecr.io
REGISTRY_SKU=Basic

# Backend Image
BACKEND_IMAGE_NAME=usecaseapp-backend
BACKEND_IMAGE_TAG=latest
BACKEND_IMAGE_FULL=${REGISTRY_URL}/${BACKEND_IMAGE_NAME}:${BACKEND_IMAGE_TAG}

# Frontend Image
FRONTEND_IMAGE_NAME=usecaseapp-frontend
FRONTEND_IMAGE_TAG=latest
FRONTEND_IMAGE_FULL=${REGISTRY_URL}/${FRONTEND_IMAGE_NAME}:${FRONTEND_IMAGE_TAG}

# ============================================
# AZURE CONTAINER APPS
# ============================================
CONTAINER_APP_ENVIRONMENT=usecaseapp-env-dev
BACKEND_APP_NAME=usecaseapp-backend-dev
FRONTEND_APP_NAME=usecaseapp-frontend-dev

# Container Apps CPU and Memory
BACKEND_CPU=0.5
BACKEND_MEMORY=1Gi
FRONTEND_CPU=0.25
FRONTEND_MEMORY=0.5Gi

# Scaling
BACKEND_MIN_REPLICAS=1
BACKEND_MAX_REPLICAS=3
FRONTEND_MIN_REPLICAS=1
FRONTEND_MAX_REPLICAS=2

# ============================================
# STORAGE CONFIGURATION
# ============================================
STORAGE_ACCOUNT_NAME=usecasestoragedev
STORAGE_ACCOUNT_SKU=Standard_LRS
FILE_SHARE_NAME=appdata
STORAGE_MOUNT_PATH=/app/data

# ============================================
# NETWORK CONFIGURATION
# ============================================
ENABLE_INGRESS=true
BACKEND_PORT=5000
FRONTEND_PORT=3000
BACKEND_INGRESS_TARGET_PORT=5000
FRONTEND_INGRESS_TARGET_PORT=3000
ALLOW_EXTERNAL_INGRESS=true

# ============================================
# BACKEND CONFIGURATION
# ============================================
FLASK_ENV=production
JWT_SECRET=<generate-secure-random-secret>
DATABASE_URL=sqlite:///./data/app.db
PORT=5000

# CORS Configuration
CORS_ORIGINS=https://<frontend-domain-dev>
CORS_ALLOW_CREDENTIALS=true

# Gunicorn Configuration
GUNICORN_WORKERS=2
GUNICORN_TIMEOUT=60

# ============================================
# FRONTEND CONFIGURATION
# ============================================
VITE_API_URL=https://<backend-domain-dev>
VITE_APP_TITLE=Use Case Assessment (Dev)
VITE_ENVIRONMENT=development

# ============================================
# LOGGING & MONITORING
# ============================================
LOG_LEVEL=INFO
ENABLE_LOG_ANALYTICS=true
LOG_ANALYTICS_WORKSPACE_ID=<your-log-analytics-workspace-id>
LOG_ANALYTICS_WORKSPACE_KEY=<your-log-analytics-workspace-key>

# Application Insights
ENABLE_APPLICATION_INSIGHTS=true
APPLICATION_INSIGHTS_CONNECTION_STRING=<your-app-insights-connection-string>

# ============================================
# DATABASE CONFIGURATION
# ============================================
DB_INIT_SCRIPT=seed.py
DB_AUTO_INIT=true
DB_BACKUP_ENABLED=true
DB_BACKUP_SCHEDULE="0 2 * * *"  # Daily at 2 AM UTC

# ============================================
# SECURITY CONFIGURATION
# ============================================
HTTPS_ONLY=true
HSTS_MAX_AGE=31536000
HSTS_INCLUDE_SUBDOMAINS=true
DISABLE_WEAK_TLS=true

# ============================================
# HEALTH CHECKS
# ============================================
BACKEND_HEALTH_CHECK_PATH=/health
BACKEND_HEALTH_CHECK_INTERVAL=10
BACKEND_HEALTH_CHECK_TIMEOUT=5
BACKEND_HEALTH_CHECK_THRESHOLD=3

FRONTEND_HEALTH_CHECK_PATH=/
FRONTEND_HEALTH_CHECK_INTERVAL=30
FRONTEND_HEALTH_CHECK_TIMEOUT=10
FRONTEND_HEALTH_CHECK_THRESHOLD=3

# ============================================
# BACKUP & DISASTER RECOVERY
# ============================================
ENABLE_AUTOMATED_BACKUPS=true
BACKUP_RETENTION_DAYS=7
BACKUP_STORAGE_ACCOUNT=usecasebackupdev

# ============================================
# DEPLOYMENT STRATEGY
# ============================================
DEPLOYMENT_TYPE=container
IMAGE_PULL_POLICY=IfNotPresent
RESTART_POLICY=Always
TERMINATION_GRACE_PERIOD=30

# ============================================
# TAGS & METADATA
# ============================================
ENVIRONMENT_TAG=dev
COST_CENTER=IT-Operations
TEAM=Platform-Engineering
APPLICATION=UseCase-Scoring-System
PROJECT=Santee-Cooper-Portfolio-Management
